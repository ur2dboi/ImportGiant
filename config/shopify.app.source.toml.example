# Copy to ../shopify.app.source.toml and replace the placeholders.
# Create this as a SEPARATE app/deployment from the destination.
client_id = "REPLACE_WITH_SOURCE_APP_CLIENT_ID"
name = "ImportGiant Source Export"
application_url = "https://REPLACE_WITH_SOURCE_HTTPS_HOST"
embedded = true

[build]
automatically_update_urls_on_dev = false

[access_scopes]
scopes = "read_products,read_inventory"

[auth]
redirect_urls = []

[webhooks]
api_version = "2026-07"
